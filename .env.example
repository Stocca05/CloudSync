# ==============================================================================
# CloudSync Server Configuration Template
# Copy this file to .env (or /etc/cloudsync/server.env) and adapt to your setup.
# ==============================================================================

# Database Connection (PostgreSQL recommended for production)
DATABASE_URL=postgresql://cloudsync:replace_with_db_password@localhost:5432/cloudsync

# 32-byte URL-safe base64 Fernet encryption key used to protect provider secrets at rest
# Generate one using: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=replace_with_base64_fernet_key

# Public address of your instance (used for web redirection, OAuth callbacks, and worker coordination)
PUBLIC_URL=http://localhost:8080

# Initial administrator credentials (created automatically on first boot)
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_admin_password_immediately

# Bootstrap token for worker nodes (can also create and revoke tokens in the Admin UI)
WORKER_TOKEN=generate_random_secret_token_for_workers

# Security settings
COOKIE_SECURE=false               # Set to 'true' in production with HTTPS / Cloudflare Tunnel
ALLOW_REGISTRATION=true           # Set to 'false' to disable public user registration

# Cluster Performance & Queue Management
GLOBAL_BPS=52428800              # Global bandwidth cap in bytes/sec (52428800 = 50 MiB/s)
MAX_ACTIVE_JOBS=64               # Maximum concurrent jobs executed across all cluster nodes
LEASE_SECONDS=25                 # Heartbeat lease duration before unsticking dead jobs

# Optional: Custom Google Cloud OAuth App Credentials
# If omitted, CloudSync uses the ephemeral local pairing helper (scripts/google_helper.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
