#!/usr/bin/env bash
set -euo pipefail
cd "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ -f /etc/cloudsync/role ]; then
  if [ "$(id -u)" != 0 ]; then echo 'Usa sudo ./start nel container.' >&2; exit 1; fi
  if [ "$(cat /etc/cloudsync/role)" = server ]; then systemctl enable --now cloudsync-api; fi
  systemctl enable --now cloudsync-worker
  if [ "$(cat /etc/cloudsync/role)" = server ]; then
    service_ready=false
    for attempt in $(seq 1 45); do
      if curl -fsS http://127.0.0.1:8080/api/health >/dev/null 2>&1; then service_ready=true; break; fi
      sleep 1
    done
    if [ "$service_ready" != true ]; then echo 'API non pronta: consulta journalctl -u cloudsync-api.' >&2; exit 1; fi
  fi
  echo 'Servizi CloudSync avviati con systemd.'
  exit 0
fi
if [ "${1:-}" = native ]; then
  exec ./deploy/install-lxc.sh "${2:-server}"
fi
if ! command -v docker >/dev/null && [ "$(uname -s)" = Linux ] && [ "$(id -u)" = 0 ]; then
  exec ./deploy/install-lxc.sh "${1:-server}"
fi
if ! command -v docker >/dev/null || ! docker compose version >/dev/null 2>&1; then
  echo 'Docker Engine e Docker Compose sono necessari. Vedi docs/DEPLOYMENT.md.' >&2
  exit 1
fi
if ! docker info >/dev/null 2>&1; then
  echo 'Docker non è avviato. Avvia Docker/Colima o il servizio Docker sul server.' >&2
  exit 1
fi
umask 077
mkdir -p runtime
# Worker runs as an unprivileged UID and needs read access only to this public-key file.
if [ ! -f runtime/known_hosts ]; then touch runtime/known_hosts; fi
chmod 644 runtime/known_hosts
mode="${1:-server}"
if [ "$mode" = worker ]; then
  if [ ! -f .env ]; then
    echo 'Crea .env con CONTROL_URL, WORKER_TOKEN e WORKER_SLOTS. Vedi docs/DEPLOYMENT.md.' >&2
    exit 1
  fi
  docker compose -f compose.worker.yaml up -d --build --wait --wait-timeout 180
  echo 'Worker avviato. Controlla che appaia online nel pannello Cluster e utenti.'
elif [ "$mode" = server ]; then
  if [ ! -f .env ]; then
    if ! command -v openssl >/dev/null; then echo 'Installa openssl per generare i segreti iniziali.' >&2; exit 1; fi
    db_secret="$(openssl rand -hex 32)"
    admin_secret="$(openssl rand -hex 10)"
    worker_secret="$(openssl rand -hex 48)"
    encryption_key="$(openssl rand -base64 32 | tr '/+' '_-')"
    cat > .env <<ENV
DB_PASSWORD=$db_secret
ENCRYPTION_KEY=$encryption_key
ADMIN_USER=admin
ADMIN_PASSWORD=$admin_secret
WORKER_TOKEN=$worker_secret
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
BIND_ADDRESS=127.0.0.1
PORT=8080
WORKER_SLOTS=2
GLOBAL_BPS=52428800
ENV
    echo 'Primo avvio: account admin e password salvati in .env (permessi 600).'
  fi
  docker compose build api
  docker compose up -d --no-build --wait --wait-timeout 180
  echo 'CloudSync avviato. Indirizzo predefinito: http://127.0.0.1:8080'
  echo 'Nome e password amministratore: ADMIN_USER e ADMIN_PASSWORD nel file .env.'
else
  echo 'Uso: ./start [server|worker]' >&2
  exit 1
fi
