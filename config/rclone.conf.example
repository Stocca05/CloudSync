# ==============================================================================
# CloudSync - Rclone Configuration Template (rclone.conf)
# ==============================================================================
# Copia questo file in config/rclone.conf e compila le credenziali.
# NOTA PRIVACY: Questo file risiede ESCLUSIVAMENTE sul tuo host locale / volume Docker.
# Nessuna credenziale viene inviata a server esterni terzi.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE DRIVE (Sorgente)
# ------------------------------------------------------------------------------
# Per generare questo blocco automaticamente puoi eseguire sul tuo computer:
#   rclone config
# e scegliere 'drive'. In alternativa, compila manualmente:
[gdrive]
type = drive
scope = drive
# Se possiedi Client ID e Secret creati su Google Cloud Console (consigliato per evitare rate limit):
client_id = 
client_secret = 
# Il token OAuth2 viene generato al login e aggiornato automaticamente da Rclone
token = {"access_token":"INSERISCI_ACCESS_TOKEN","token_type":"Bearer","refresh_token":"INSERISCI_REFRESH_TOKEN","expiry":"2026-10-01T00:00:00Z"}


# ------------------------------------------------------------------------------
# 2. ICLOUD DRIVE (Destinazione)
# ------------------------------------------------------------------------------
# iCloud Drive non dispone di una REST API pubblica aperta senza 2FA, ma è supportato
# tramite WebDAV (con Apple App-Specific Password) oppure tramite un bridge/mount locale.
#
# METODO A (Consigliato): WebDAV con Password specifica per l'app Apple
# 1. Accedi a https://appleid.apple.com/account/manage
# 2. Vai su "Password specifiche per le app" e generane una (es. "cloudsync-rclone")
# 3. Utilizza il comando 'rclone obscure tua_password' per ottenere la password cifrata
[icloud]
type = webdav
url = https://p58-content.icloud.com
vendor = other
user = tuousername@icloud.com
pass = TuaPasswordOscurataConRcloneObscure

# ------------------------------------------------------------------------------
# METODO B: Test Locale o Cartella Host Montata
# Se esegui test o monti una cartella locale simulata:
# [icloud]
# type = local
