[Unit]
Description=CloudSync Rclone worker
After=network-online.target
Wants=network-online.target
[Service]
User=cloudsync
Group=cloudsync
WorkingDirectory=/opt/cloudsync
EnvironmentFile=/etc/cloudsync/worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/opt/cloudsync/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/cloudsync/.venv/bin/python -m cloudsync.worker
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=512M
TasksMax=256
[Install]
WantedBy=multi-user.target
