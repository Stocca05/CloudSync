[Unit]
Description=CloudSync temporary Cloudflare access
After=network-online.target cloudsync-api.service
Wants=network-online.target
[Service]
User=cloudsync
Group=cloudsync
Environment=HOME=/var/lib/cloudsync
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8080
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
[Install]
WantedBy=multi-user.target
