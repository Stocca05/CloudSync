# CloudSync Worker Node Configuration

# Unique name of this node (as displayed in the Admin Dashboard)
NODE_NAME=mac-stocca

# Primary URL of the CloudSync Control Plane API (LAN IP or Public Tunnel URL)
CONTROL_URL=http://192.168.1.98:8080

# Optional fallback URL if the primary URL is unreachable
FALLBACK_URL=

# Secret worker token generated in the CloudSync Admin Dashboard
WORKER_TOKEN=your_node_token_here

# Maximum concurrent transfer jobs to handle simultaneously (1-32)
WORKER_SLOTS=4

# Maximum bandwidth limit in MiB/s allocated to this node
BANDWIDTH_LIMIT_MBPS=50.0
